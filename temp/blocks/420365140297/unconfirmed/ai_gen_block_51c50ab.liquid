{% doc %}
  @prompt
    Create a dynamic collection navigation button system that automatically detects if the current page is a main collection or sub-collection and displays horizontal navigation buttons for all related sub-collections. The system should:
    
    1. Automatically detect parent-child relationships between collections by analyzing the navigation menu structure
    2. Display navigation buttons for sibling collections when viewing either a parent collection or any of its sub-collections
    3. Show buttons with only the sub-collection names (not the parent collection name)
    4. Highlight the currently active collection button
    5. Handle cases where a collection (like "sandalias") appears in multiple categories by linking to the correct parent category
    6. Work on both main collection pages and sub-collection pages
    
    7. Display buttons horizontally in a clean, responsive layout
    8. do not increase the scale on hover but apply  color on hover
    The navigation should work for collections like "primeros pasos" with sub-collections including babuchas, sandalias, botas y botines, zapatos, deportivas, merceditas y pepitos, and a "todo primeros pasos" option. Include proper styling for active states and responsive design., it is not appearing. should you put the button inside a section, follow the style of the buttons with complete rounded corner, please leave a place here in the dashboard that i can see and fix the links of the button in case it is not currectly, every collection page should have the buttons not only Primeros Pasos, but also Caminantes, Adultos, Accesorios and each button should be related for the specific subitem menu collection, the links are not right. check they and link the buttons with the subitem menu page correctly. the links are sending to 404 page. Create a dynamic button navigation system that appears on both main collection pages and sub-collection pages. The buttons should automatically detect if the current page is a main collection (like "primeros pasos") or a sub-collection (like "babuchas" under "primeros pasos") and display all the related sub-items as horizontal buttons. For example, when viewing either the "primeros pasos" collection page OR any of its sub-collections like "babuchas", "sandalias", "botas y botines", etc., the same set of navigation buttons should appear showing: babuchas, sandalias, botas y botines, zapatos, deportivas, merceditas y pepitos, todo primeros pasos. The system should work by checking the navigation menu structure to find parent

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-nav-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-collection-nav__container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-collection-nav__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_spacing }}px;
    overflow-x: auto;
    padding: 10px 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-collection-nav__buttons-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-nav__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: 9999px;
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    white-space: nowrap;
    min-width: fit-content;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-collection-nav__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-collection-nav__button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.button_active_bg_color }};
    color: {{ block.settings.button_active_text_color }};
    border-color: {{ block.settings.button_active_border_color }};
  }

  .ai-collection-nav__button-{{ ai_gen_id }}.active:hover {
    background-color: {{ block.settings.button_active_hover_bg_color }};
    color: {{ block.settings.button_active_hover_text_color }};
    border-color: {{ block.settings.button_active_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-nav__container-{{ ai_gen_id }} {
      padding: 0 15px;
    }

    .ai-collection-nav__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<collection-navigation-{{ ai_gen_id }}
  class="ai-collection-nav-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-current-collection="{{ collection.handle | default: '' }}"
  data-current-page="{{ request.page_type }}"
  data-show-parent="{{ block.settings.show_parent_button }}"
>
  <div class="ai-collection-nav__container-{{ ai_gen_id }}">
    <div class="ai-collection-nav__buttons-{{ ai_gen_id }}" id="ai-collection-nav-buttons-{{ ai_gen_id }}"></div>
  </div>
</collection-navigation-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionNavigation{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentCollectionHandle = this.dataset.currentCollection;
        this.currentPageType = this.dataset.currentPage;
        this.showParentButton = this.dataset.showParent === 'true';
        this.buttonsContainer = this.querySelector('#ai-collection-nav-buttons-{{ ai_gen_id }}');
        this.menuStructure = this.parseMenuStructure();}connectedCallback() {
        this.buildNavigation();
      }

      parseMenuStructure() {
        const menuStructure = {};
        {% if linklists[block.settings.main_menu].links.size > 0 %}
          {% for link in linklists[block.settings.main_menu].links %}
            {% if link.links.size > 0 %}
              menuStructure['{{ link.url | split: '/' | last }}'] = {
                parent: '{{ link.url | split: '/' | last }}',
                title: '{{ link.title | escape }}',
                url: '{{ link.url }}',
                children: [
                  {% for sublink in link.links %}
                    {
                      handle: '{{ sublink.url | split: '/' | last }}',
                      title: '{{ sublink.title | escape }}',
                      url: '{{ sublink.url }}'
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              };
            {% endif %}
          {% endfor %}
        {% endif %}

        return menuStructure;
      }

      buildNavigation() {
        if (this.currentPageType !== 'collection') {
          this.hide();
          return;
        }

        if (!this.currentCollectionHandle) {
          this.hide();
          return;
        }

        const currentGroup = this.findCurrentGroup();
        if (!currentGroup || !currentGroup.children || currentGroup.children.length === 0) {
          this.hide();
          return;
        }

        this.renderButtons(currentGroup);this.show();
      }

      findCurrentGroup() {
        for (const [groupKey, group] of Object.entries(this.menuStructure)) {
          if (group.parent === this.currentCollectionHandle) {
            return group;
          }if (group.children && group.children.some(child => child.handle === this.currentCollectionHandle)) {
            return group;
          }
        }
        return null;
      }

      renderButtons(group) {
        this.buttonsContainer.innerHTML = '';
        
        if (this.showParentButton) {
          const parentButton = document.createElement('a');
          parentButton.href = group.url;
          parentButton.className = 'ai-collection-nav__button-{{ ai_gen_id }}';
          if (group.parent === this.currentCollectionHandle) {
            parentButton.classList.add('active');
          }
          parentButton.textContent ='Todo ' + group.title.toLowerCase();
          this.buttonsContainer.appendChild(parentButton);
        }
        
        group.children.forEach(collection => {
          if (!collection.handle || !collection.url) return;
          
          const button = document.createElement('a');
          button.href = collection.url;
          button.className = 'ai-collection-nav__button-{{ ai_gen_id }}';
          if (collection.handle === this.currentCollectionHandle) {
            button.classList.add('active');
          }
          
          button.textContent = collection.title;
          this.buttonsContainer.appendChild(button);
        });
      }

      show() {
        this.style.display = 'block';
      }

      hide() {
        this.style.display = 'none';
      }
    }

    customElements.define('collection-navigation-{{ ai_gen_id }}', CollectionNavigation{{ ai_gen_id }});
  })();
</script>

