{% doc %}
  @prompt
    Create a dynamic collection navigation button system that automatically detects if the current page is a main collection or sub-collection and displays horizontal navigation buttons for all related sub-collections. The system should:
    
    1. Automatically detect parent-child relationships between collections by analyzing the navigation menu structure
    2. Display navigation buttons for sibling collections when viewing either a parent collection or any of its sub-collections
    3. Show buttons with only the sub-collection names (not the parent collection name)
    4. Highlight the currently active collection button
    5. Handle cases where a collection (like "sandalias") appears in multiple categories by linking to the correct parent category
    6. Work on both main collection pages and sub-collection pages
    
    7. Display buttons horizontally in a clean, responsive layout
    8. do not increase the scale on hover but apply  color on hover
    The navigation should work for collections like "primeros pasos" with sub-collections including babuchas, sandalias, botas y botines, zapatos, deportivas, merceditas y pepitos, and a "todo primeros pasos" option. Include proper styling for active states and responsive design.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-nav-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};}

  .ai-collection-nav__container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-collection-nav__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_spacing }}px;
    overflow-x: auto;
    padding: 10px 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-collection-nav__buttons-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-nav__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    white-space: nowrap;
    min-width: fit-content;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-collection-nav__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-collection-nav__button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.button_active_bg_color }};
    color: {{ block.settings.button_active_text_color }};
    border-color: {{ block.settings.button_active_border_color }};
  }

  .ai-collection-nav__button-{{ ai_gen_id }}.active:hover {
    background-color: {{ block.settings.button_active_hover_bg_color }};
    color: {{ block.settings.button_active_hover_text_color }};
    border-color: {{ block.settings.button_active_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-nav__container-{{ ai_gen_id }} {
      padding: 0 15px;
    }

    .ai-collection-nav__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<collection-navigation-{{ ai_gen_id }}
  class="ai-collection-nav-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-current-collection="{{ collection.handle | default: '' }}"
>
  <div class="ai-collection-nav__container-{{ ai_gen_id }}">
    <div class="ai-collection-nav__buttons-{{ ai_gen_id }}" id="ai-collection-nav-buttons-{{ ai_gen_id }}"></div>
  </div>
</collection-navigation-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionNavigation{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentCollectionHandle = this.dataset.currentCollection;
        this.menuData = null;
        this.collectionRelationships = new Map();
        this.buttonsContainer = this.querySelector('#ai-collection-nav-buttons-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.fetchMenuData();
      }

      async fetchMenuData() {
        try {
          const response = await fetch('/search/suggest.json?q=*&resources[type]=collection&resources[limit]=250');
          const data = await response.json();
          
          if (data.resources && data.resources.results && data.resources.results.collections) {
            this.processCollections(data.resources.results.collections);
            this.buildNavigation();
          }
        } catch (error) {
          console.error('Error fetching collection data:', error);this.fallbackToCurrentCollection();
        }
      }

      processCollections(collections) {
        const allCollections = new Map();
        
        collections.forEach(collection => {
          allCollections.set(collection.handle, {
            handle: collection.handle,
            title: collection.title,
            url: collection.url
          });
        });

        this.analyzeCollectionRelationships(allCollections);
      }

      analyzeCollectionRelationships(collections) {
        const parentPatterns = [
          'primeros pasos',
          'niña',
          'niño',
          'bebe',
          'mujer',
          'hombre'
        ];

        const subCollectionKeywords = [
          'babuchas',
          'sandalias',
          'botas',
          'botines',
          'zapatos',
          'deportivas',
          'merceditas',
          'pepitos',
          'todo'
        ];

        collections.forEach((collection, handle) => {
          const title = collection.title.toLowerCase();
          
          parentPatterns.forEach(parentPattern => {
            if (title.includes(parentPattern)) {
              if (!this.collectionRelationships.has(parentPattern)) {
                this.collectionRelationships.set(parentPattern, {
                  parent: collection,
                  children: []
                });
              }

              const relationship = this.collectionRelationships.get(parentPattern);
              
              const hasSubKeyword = subCollectionKeywords.some(keyword => 
                title.includes(keyword) && title !== parentPattern
              );

              if (hasSubKeyword || title.includes('todo ' + parentPattern)) {
                relationship.children.push(collection);
              } else if (title === parentPattern) {
                relationship.parent = collection;
              }
            }
          });
        });

        this.collectionRelationships.forEach((relationship, parentKey) => {
          relationship.children.sort((a, b) => {
            if (a.title.toLowerCase().includes('todo')) return -1;
            if (b.title.toLowerCase().includes('todo')) return 1;
            return a.title.localeCompare(b.title);
          });
        });
      }

      buildNavigation() {
        if (!this.currentCollectionHandle) {
          this.hide();
          return;
        }

        const currentRelationship = this.findCurrentCollectionRelationship();
        
        if (!currentRelationship || currentRelationship.children.length === 0) {
          this.hide();
          return;
        }

        this.renderButtons(currentRelationship.children);
        this.show();
      }

      findCurrentCollectionRelationship() {
        for (const [parentKey, relationship] of this.collectionRelationships) {
          if (relationship.parent && relationship.parent.handle === this.currentCollectionHandle) {
            return relationship;
          }
          
          if (relationship.children.some(child => child.handle === this.currentCollectionHandle)) {
            return relationship;
          }
        }
        return null;
      }

      renderButtons(collections) {
        this.buttonsContainer.innerHTML = '';
        
        collections.forEach(collection => {
          const button = document.createElement('a');
          button.href = collection.url;
          button.className = 'ai-collection-nav__button-{{ ai_gen_id }}';
          
          if (collection.handle === this.currentCollectionHandle) {
            button.classList.add('active');
          }
          
          const displayTitle = this.getDisplayTitle(collection.title);
          button.textContent = displayTitle;
          
          this.buttonsContainer.appendChild(button);
        });
      }

      getDisplayTitle(title) {
        const parentPatterns = [
          'primeros pasos',
          'niña',
          'niño',
          'bebe',
          'mujer',
          'hombre'
        ];

        let cleanTitle = title;
        
        parentPatterns.forEach(pattern => {
          const regex = new RegExp(pattern, 'gi');
          cleanTitle = cleanTitle.replace(regex, '').trim();
        });

        cleanTitle = cleanTitle.replace(/^(todo\s+)/i, 'Todo ');
        
        return cleanTitle || title;
      }

      fallbackToCurrentCollection() {
        this.hide();
      }

      show() {
        this.style.display = 'block';
      }

      hide() {
        this.style.display = 'none';
      }
    }

    customElements.define('collection-navigation-{{ ai_gen_id }}', CollectionNavigation{{ ai_gen_id }});
  })();
</script>

