{% doc %}
  @prompt
    Create a dynamic collection navigation button system that automatically detects if the current page is a main collection or sub-collection and displays horizontal navigation buttons for all related sub-collections. The system should:
    
    1. Automatically detect parent-child relationships between collections by analyzing the navigation menu structure
    2. Display navigation buttons for sibling collections when viewing either a parent collection or any of its sub-collections
    3. Show buttons with only the sub-collection names (not the parent collection name)
    4. Highlight the currently active collection button
    5. Handle cases where a collection (like "sandalias") appears in multiple categories by linking to the correct parent category
    6. Work on both main collection pages and sub-collection pages
    
    7. Display buttons horizontally in a clean, responsive layout
    8. do not increase the scale on hover but apply  color on hover
    The navigation should work for collections like "primeros pasos" with sub-collections including babuchas, sandalias, botas y botines, zapatos, deportivas, merceditas y pepitos, and a "todo primeros pasos" option. Include proper styling for active states and responsive design., it is not appearing. should you put the button inside a section, follow the style of the buttons with complete rounded corner, please leave a place here in the dashboard that i can see and fix the links of the button in case it is not currectly, every collection page should have the buttons not only Primeros Pasos, but also Caminantes, Adultos, Accesorios and each button should be related for the specific subitem menu collection

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-nav-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-collection-nav__container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-collection-nav__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_spacing }}px;
    overflow-x: auto;
    padding: 10px 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-collection-nav__buttons-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-nav__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: 9999px;
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    white-space: nowrap;
    min-width: fit-content;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-collection-nav__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-collection-nav__button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.button_active_bg_color }};
    color: {{ block.settings.button_active_text_color }};
    border-color: {{ block.settings.button_active_border_color }};
  }

  .ai-collection-nav__button-{{ ai_gen_id }}.active:hover {
    background-color: {{ block.settings.button_active_hover_bg_color }};
    color: {{ block.settings.button_active_hover_text_color }};
    border-color: {{ block.settings.button_active_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-nav__container-{{ ai_gen_id }} {
      padding: 0 15px;
    }

    .ai-collection-nav__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<collection-navigation-{{ ai_gen_id }}
  class="ai-collection-nav-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-current-collection="{{ collection.handle | default: '' }}"
>
  <div class="ai-collection-nav__container-{{ ai_gen_id }}">
    <div class="ai-collection-nav__buttons-{{ ai_gen_id }}" id="ai-collection-nav-buttons-{{ ai_gen_id }}"></div>
  </div>
</collection-navigation-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionNavigation{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentCollectionHandle = this.dataset.currentCollection;
        this.buttonsContainer = this.querySelector('#ai-collection-nav-buttons-{{ ai_gen_id }}');
        this.collectionGroups = this.getCollectionGroups();}

      connectedCallback() {
        this.buildNavigation();
      }

      getCollectionGroups() {
        const customMappings = this.getCustomMappings();
        return {
          'primeros-pasos': {
            parent: 'primeros-pasos',
            children: [
              { handle: customMappings.primeros_pasos_todo || 'todo-primeros-pasos', title: 'Todo primeros pasos' },
              { handle: customMappings.primeros_pasos_babuchas || 'babuchas-primeros-pasos', title: 'Babuchas' },
              { handle: customMappings.primeros_pasos_sandalias || 'sandalias-primeros-pasos', title: 'Sandalias' },
              { handle: customMappings.primeros_pasos_botas || 'botas-y-botines-primeros-pasos', title: 'Botas y botines' },
              { handle: customMappings.primeros_pasos_zapatos || 'zapatos-primeros-pasos', title: 'Zapatos' },
              { handle: customMappings.primeros_pasos_deportivas || 'deportivas-primeros-pasos', title: 'Deportivas' },
              { handle: customMappings.primeros_pasos_merceditas || 'merceditas-y-pepitos-primeros-pasos', title: 'Merceditas y pepitos' }
            ]
          },
          'caminantes': {
            parent: 'caminantes',
            children: [
              { handle: customMappings.caminantes_todo || 'todo-caminantes', title: 'Todo caminantes' },
              { handle: customMappings.caminantes_nina || 'nina-caminantes', title: 'Niña' },
              { handle: customMappings.caminantes_nino || 'nino-caminantes', title: 'Niño' },
              { handle: customMappings.caminantes_babuchas || 'babuchas-caminantes', title: 'Babuchas' },
              { handle: customMappings.caminantes_sandalias || 'sandalias-caminantes', title: 'Sandalias' },
              { handle: customMappings.caminantes_botas || 'botas-y-botines-caminantes', title: 'Botas y botines' },
              { handle: customMappings.caminantes_zapatos || 'zapatos-caminantes', title: 'Zapatos' },
              { handle: customMappings.caminantes_deportivas || 'deportivas-caminantes', title: 'Deportivas' },
              { handle: customMappings.caminantes_merceditas || 'merceditas-y-pepitos-caminantes', title: 'Merceditas y pepitos' }
            ]
          },
          'nina': {
            parent: 'nina',
            children: [
              { handle: customMappings.nina_todo || 'todo-nina', title: 'Todo niña' },
              { handle: customMappings.nina_babuchas || 'babuchas-nina', title: 'Babuchas' },
              { handle: customMappings.nina_sandalias || 'sandalias-nina', title: 'Sandalias' },
              { handle: customMappings.nina_botas || 'botas-y-botines-nina', title: 'Botas y botines' },
              { handle: customMappings.nina_zapatos || 'zapatos-nina', title: 'Zapatos' },
              { handle: customMappings.nina_deportivas || 'deportivas-nina', title: 'Deportivas' },
              { handle: customMappings.nina_merceditas || 'merceditas-y-pepitos-nina', title: 'Merceditas y pepitos' }
            ]
          },
          'nino': {
            parent: 'nino',
            children: [
              { handle: customMappings.nino_todo || 'todo-nino', title: 'Todo niño' },
              { handle: customMappings.nino_babuchas || 'babuchas-nino', title: 'Babuchas' },
              { handle: customMappings.nino_sandalias || 'sandalias-nino', title: 'Sandalias' },
              { handle: customMappings.nino_botas || 'botas-y-botines-nino', title: 'Botas y botines' },
              { handle: customMappings.nino_zapatos || 'zapatos-nino', title: 'Zapatos' },
              { handle: customMappings.nino_deportivas || 'deportivas-nino', title: 'Deportivas' }
            ]
          },
          'bebe': {
            parent: 'bebe',
            children: [
              { handle: customMappings.bebe_todo || 'todo-bebe', title: 'Todo bebé' },
              { handle: customMappings.bebe_babuchas || 'babuchas-bebe', title: 'Babuchas' },
              { handle: customMappings.bebe_sandalias || 'sandalias-bebe', title: 'Sandalias' },
              { handle: customMappings.bebe_botas || 'botas-y-botines-bebe', title: 'Botas y botines' },
              { handle: customMappings.bebe_zapatos || 'zapatos-bebe', title: 'Zapatos' }
            ]
          },
          'adultos': {
            parent: 'adultos',
            children: [
              { handle: customMappings.adultos_todo || 'todo-adultos', title: 'Todo adultos' },
              { handle: customMappings.adultos_mujer || 'mujer-adultos', title: 'Mujer' },
              { handle: customMappings.adultos_hombre || 'hombre-adultos', title: 'Hombre' },
              { handle: customMappings.adultos_babuchas || 'babuchas-adultos', title: 'Babuchas' },
              { handle: customMappings.adultos_sandalias || 'sandalias-adultos', title: 'Sandalias' },
              { handle: customMappings.adultos_botas || 'botas-y-botines-adultos', title: 'Botas y botines' },
              { handle: customMappings.adultos_zapatos || 'zapatos-adultos', title: 'Zapatos' },
              { handle: customMappings.adultos_deportivas || 'deportivas-adultos', title: 'Deportivas' }
            ]
          },
          'accesorios': {
            parent: 'accesorios',
            children: [
              { handle: customMappings.accesorios_todo || 'todo-accesorios', title: 'Todo accesorios' },
              { handle: customMappings.accesorios_calcetines || 'calcetines-accesorios', title: 'Calcetines' },
              { handle: customMappings.accesorios_cuidado || 'cuidado-calzado-accesorios', title: 'Cuidado del calzado' },
              { handle: customMappings.accesorios_plantillas || 'plantillas-accesorios', title: 'Plantillas' },
              { handle: customMappings.accesorios_cordones || 'cordones-accesorios', title: 'Cordones' },
              { handle: customMappings.accesorios_otros || 'otros-accesorios', title: 'Otros' }
            ]
          }
        };
      }

      getCustomMappings() {
        return {
          primeros_pasos_todo: '{{ block.settings.primeros_pasos_todo }}',
          primeros_pasos_babuchas: '{{ block.settings.primeros_pasos_babuchas }}',
          primeros_pasos_sandalias: '{{ block.settings.primeros_pasos_sandalias }}',
          primeros_pasos_botas: '{{ block.settings.primeros_pasos_botas }}',
          primeros_pasos_zapatos: '{{ block.settings.primeros_pasos_zapatos }}',
          primeros_pasos_deportivas: '{{ block.settings.primeros_pasos_deportivas }}',
          primeros_pasos_merceditas: '{{ block.settings.primeros_pasos_merceditas }}',
          caminantes_todo: '{{ block.settings.caminantes_todo }}',
          caminantes_nina: '{{ block.settings.caminantes_nina }}',
          caminantes_nino: '{{ block.settings.caminantes_nino }}',
          caminantes_babuchas: '{{ block.settings.caminantes_babuchas }}',
          caminantes_sandalias: '{{ block.settings.caminantes_sandalias }}',
          caminantes_botas: '{{ block.settings.caminantes_botas }}',
          caminantes_zapatos: '{{ block.settings.caminantes_zapatos }}',
          caminantes_deportivas: '{{ block.settings.caminantes_deportivas }}',
          caminantes_merceditas: '{{ block.settings.caminantes_merceditas }}',
          nina_todo: '{{ block.settings.nina_todo }}',
          nina_babuchas: '{{ block.settings.nina_babuchas }}',
          nina_sandalias: '{{ block.settings.nina_sandalias }}',
          nina_botas: '{{ block.settings.nina_botas }}',
          nina_zapatos: '{{ block.settings.nina_zapatos }}',
          nina_deportivas: '{{ block.settings.nina_deportivas }}',
          nina_merceditas: '{{ block.settings.nina_merceditas }}',
          nino_todo: '{{ block.settings.nino_todo }}',
          nino_babuchas: '{{ block.settings.nino_babuchas }}',
          nino_sandalias: '{{ block.settings.nino_sandalias }}',
          nino_botas: '{{ block.settings.nino_botas }}',
          nino_zapatos: '{{ block.settings.nino_zapatos }}',
          nino_deportivas: '{{ block.settings.nino_deportivas }}',
          bebe_todo: '{{ block.settings.bebe_todo }}',
          bebe_babuchas: '{{ block.settings.bebe_babuchas }}',
          bebe_sandalias: '{{ block.settings.bebe_sandalias }}',
          bebe_botas: '{{ block.settings.bebe_botas }}',
          bebe_zapatos: '{{ block.settings.bebe_zapatos }}',
          adultos_todo: '{{ block.settings.adultos_todo }}',
          adultos_mujer: '{{ block.settings.adultos_mujer }}',
          adultos_hombre: '{{ block.settings.adultos_hombre }}',
          adultos_babuchas: '{{ block.settings.adultos_babuchas }}',
          adultos_sandalias: '{{ block.settings.adultos_sandalias }}',
          adultos_botas: '{{ block.settings.adultos_botas }}',
          adultos_zapatos: '{{ block.settings.adultos_zapatos }}',
          adultos_deportivas: '{{ block.settings.adultos_deportivas }}',
          accesorios_todo: '{{ block.settings.accesorios_todo }}',
          accesorios_calcetines: '{{ block.settings.accesorios_calcetines }}',
          accesorios_cuidado: '{{ block.settings.accesorios_cuidado }}',
          accesorios_plantillas: '{{ block.settings.accesorios_plantillas }}',
          accesorios_cordones: '{{ block.settings.accesorios_cordones }}',
          accesorios_otros: '{{ block.settings.accesorios_otros }}'
        };
      }

      buildNavigation() {
        if (!this.currentCollectionHandle) {
          this.hide();
          return;
        }

        const currentGroup = this.findCurrentGroup();
        if (!currentGroup) {
          this.hide();
          return;
        }

        this.renderButtons(currentGroup.children);
        this.show();
      }

      findCurrentGroup() {
        for (const [groupKey, group] of Object.entries(this.collectionGroups)) {
          if (group.parent === this.currentCollectionHandle) {
            return group;
          }if (group.children.some(child => child.handle === this.currentCollectionHandle)) {
            return group;
          }
        }
        return null;
      }

      renderButtons(collections) {
        this.buttonsContainer.innerHTML = '';
        
        collections.forEach(collection => {
          if (!collection.handle) return;
          
          const button = document.createElement('a');
          button.href = `/collections/${collection.handle}`;
          button.className = 'ai-collection-nav__button-{{ ai_gen_id }}';
          
          if (collection.handle === this.currentCollectionHandle) {
            button.classList.add('active');
          }
          
          button.textContent = collection.title;
          this.buttonsContainer.appendChild(button);
        });
      }

      show() {
        this.style.display = 'block';
      }

      hide() {
        this.style.display = 'none';
      }
    }

    customElements.define('collection-navigation-{{ ai_gen_id }}', CollectionNavigation{{ ai_gen_id }});
  })();
</script>

