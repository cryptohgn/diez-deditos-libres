{% doc %}
  @prompt
    d
    
    AI generated
    
    
    Contenedor Principal: La sección debe tener un contenedor principal con ajustes de padding superior e inferior.
    
    Encabezado: En la parte superior, incluye un título principal (<h2>) y un subtítulo (<p>), ambos centrados.
    
    Cuadrícula de Características: Debajo del encabezado, crea una cuadrícula de tres columnas. En dispositivos móviles (pantallas de menos de 768px), estas columnas deben apilarse una encima de la otra.
    
    Contenido de cada Columna (Bloques): Cada una de las tres columnas debe contener los siguientes elementos, centrados verticalmente:
    
    Un ícono SVG con un estilo de arte lineal (line-art), similar a los de la referencia (un zapato flexible, un zapato plano, una horma ancha). El ícono debe estar dentro de un círculo con un color de fondo suave.
    
    Un título de característica (<h3>).
    
    Un párrafo de descripción (<p>).
    
    Botón de Llamada a la Acción (CTA): Debajo de la cuadrícula de tres columnas, añade un único botón centrado. Este botón será el único CTA de la sección.
    
    Funcionalidad y Personalización (Schema de Shopify):
    
    Crea un schema de Shopify que permita al usuario editar lo siguiente desde el personalizador de temas:
    
    1. Ajustes Generales de la Sección (settings):
    Encabezado:
    text para el título principal.
    text para el subtítulo.
    Botón:
    text para el texto del botón.
    url para el enlace del botón.
    Colores:
    color para el fondo de la sección.
    color para el color del título principal.
    color para el color del subtítulo y texto general.
    color para el fondo del botón.
    color para el texto del botón.
    Tipografía:
    range para el tamaño de la fuente del título principal (ej: de 24px a 60px).
    range para el tamaño de la fuente de los títulos de las características (ej: de 16px a 32px).
    range para el tamaño de la fuente del texto descriptivo (ej: de 12px a 20px).
    Espaciado: range para el padding superior y inferior de la sección.
    image_picker para que el usuario pueda subir su propio ícono SVG o imagen., el botons debe seguir el estilo del boton prin

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.section_bg_color }};
  }

  .ai-features-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-features-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-features-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px 0;
    line-height: 1.2;
  }

  .ai-features-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-features-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-bottom: 50px;
  }

  .ai-features-item-{{ ai_gen_id }} {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-features-icon-wrapper-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .ai-features-icon-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 1.5;
  }

  .ai-features-item-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px 0;
    line-height: 1.3;
  }

  .ai-features-item-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-features-cta-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-features-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 15px 30px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-features-button-{{ ai_gen_id }}:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  @media screen and (max-width: 767px) {
    .ai-features-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;gap: 30px;
    }

    .ai-features-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size }}px * 0.8);
    }

    .ai-features-item-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.feature_title_font_size }}px * 0.9);
    }
  }
{% endstyle %}<div class="ai-features-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-container-{{ ai_gen_id }}">
    <div class="ai-features-header-{{ ai_gen_id }}">
      {% if block.settings.main_title != blank %}
        <h2 class="ai-features-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-features-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-features-grid-{{ ai_gen_id }}">
      <div class="ai-features-item-{{ ai_gen_id }}">
        <div class="ai-features-icon-wrapper-{{ ai_gen_id }}">
          {% if block.settings.feature_1_icon %}
            <img src="{{ block.settings.feature_1_icon | image_url: width: 40}}" alt="{{ block.settings.feature_1_title }}" class="ai-features-icon-{{ ai_gen_id }}">
          {% else %}
            <svg class="ai-features-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L2 7v10c0 5.55 3.84 9.74 9 115.16-1.26 9-5.45 9-11V7l-10-5z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          {% endif %}
        </div><h3 class="ai-features-item-title-{{ ai_gen_id }}">{{ block.settings.feature_1_title | default: 'Característica 1' }}</h3>
        <p class="ai-features-item-description-{{ ai_gen_id }}">{{ block.settings.feature_1_description | default: 'Descripción de la primera característica del producto.' }}</p>
      </div>

      <div class="ai-features-item-{{ ai_gen_id }}">
        <div class="ai-features-icon-wrapper-{{ ai_gen_id }}">
          {% if block.settings.feature_2_icon %}
            <img src="{{ block.settings.feature_2_icon | image_url: width: 40 }}" alt="{{ block.settings.feature_2_title }}" class="ai-features-icon-{{ ai_gen_id }}">
          {% else %}
            <svg class="ai-features-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="10"/>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
              <line x1="9" y1="9" x2="9.01" y2="9"/>
              <line x1="15" y1="9" x2="15.01" y2="9"/>
            </svg>
          {% endif %}
        </div>
        <h3 class="ai-features-item-title-{{ ai_gen_id }}">{{ block.settings.feature_2_title | default: 'Característica 2' }}</h3>
        <p class="ai-features-item-description-{{ ai_gen_id }}">{{ block.settings.feature_2_description | default: 'Descripción de la segunda característica del producto.' }}</p>
      </div>

      <div class="ai-features-item-{{ ai_gen_id }}">
        <div class="ai-features-icon-wrapper-{{ ai_gen_id }}">
          {% if block.settings.feature_3_icon %}
            <img src="{{ block.settings.feature_3_icon | image_url: width: 40 }}" alt="{{ block.settings.feature_3_title }}" class="ai-features-icon-{{ ai_gen_id }}">
          {% else %}
            <svg class="ai-features-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M2212h-4l-3 9L9 3l-3 9H2"/></svg>
          {% endif %}
        </div>
        <h3 class="ai-features-item-title-{{ ai_gen_id }}">{{ block.settings.feature_3_title | default: 'Característica 3' }}</h3>
        <p class="ai-features-item-description-{{ ai_gen_id }}">{{ block.settings.feature_3_description | default: 'Descripción de la tercera característica del producto.' }}</p>
      </div>
    </div>

    {% if block.settings.button_text != blank %}
      <div class="ai-features-cta-{{ ai_gen_id }}">
        <a href="{{ block.settings.button_link }}" class="ai-features-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Features grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main title",
      "default": "Características principales"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Descubre las ventajas únicas de nuestros productos"
    },
    {
      "type": "header",
      "content": "Feature 1"
    },
    {
      "type": "image_picker",
      "id": "feature_1_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Title",
      "default": "Flexibilidad"
    },
    {
      "type": "textarea",
      "id": "feature_1_description",
      "label": "Description",
      "default": "Diseño ergonómico que se adapta perfectamente a tu pie"
    },
    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "image_picker",
      "id": "feature_2_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Title",
      "default": "Comodidad"
    },
    {
      "type": "textarea",
      "id": "feature_2_description",
      "label": "Description",
      "default": "Materiales suaves y transpirables para uso diario"
    },
    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "image_picker",
      "id": "feature_3_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Title",
      "default": "Durabilidad"
    },
    {
      "type": "textarea",
      "id": "feature_3_description",
      "label": "Description",
      "default": "Construcción resistente para un uso prolongado"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Ver productos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon background",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#007bff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#007bff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Main title size",
      "default": 36
    },
    {
      "type": "range",
      "id": "feature_title_font_size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Feature title size",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Features grid"
    }
  ]
}
{% endschema %}