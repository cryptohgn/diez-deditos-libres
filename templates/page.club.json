      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div id=\"unete\" style=\"width:100%;max-width:640px;margin:0 auto;padding-inline:1.5rem;box-sizing:border-box;text-align:center;\">\n  <h2 class=\"h2\">Únete al Club Family</h2>\n  <p>Déjanos tu email y te enviamos los siguientes pasos. Sin spam: solo lo del Club.</p>\n  {%- form 'customer', id: 'ClubFamilyForm', is: 'club-form' -%}\n    <input type=\"hidden\" name=\"contact[tags]\" value=\"club-family\">\n    {%- if form.posted_successfully? -%}\n      <p class=\"form-message alert alert--success blocks-radius\" tabindex=\"-1\" autofocus>¡Bienvenida/o al Club! Revisa tu correo.</p>\n    {%- endif -%}\n    {%- if form.errors -%}\n      <p class=\"form-message alert alert--error blocks-radius\">{{ form.errors | default_errors }}</p>\n    {%- endif -%}\n    <div class=\"form-field\" style=\"margin-bottom:12px;\">\n      <label class=\"form-label\" for=\"ClubName\">Nombre</label>\n      <input id=\"ClubName\" type=\"text\" name=\"contact[first_name]\" class=\"form-control\" autocomplete=\"given-name\">\n    </div>\n    <div class=\"form-field\" style=\"margin-bottom:12px;\">\n      <label class=\"form-label\" for=\"ClubEmail\">Email</label>\n      <input id=\"ClubEmail\" type=\"email\" name=\"contact[email]\" class=\"form-control\" value=\"{{ form.email }}\" autocomplete=\"email\" autocorrect=\"off\" autocapitalize=\"off\" required>\n    </div>\n    <div style=\"margin-bottom:16px;text-align:left;\">\n      <label>\n        <input type=\"checkbox\" required>\n        He leído y acepto la <a href=\"{{ routes.root_url }}policies/privacy-policy\" target=\"_blank\" rel=\"noopener\">política de privacidad</a> y quiero recibir comunicaciones del Club.\n      </label>\n    </div>\n    <button type=\"submit\" class=\"btn btn--primary w-full\" name=\"commit\">Unirme al Club</button>\n  {%- endform -%}\n</div>",
