    "club_form": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  #unete{width:100%;max-width:760px;margin:0 auto;padding-inline:1.5rem;box-sizing:border-box;scroll-margin-top:100px;}\n  #unete .club-grid{display:grid;gap:12px;grid-template-columns:1fr;margin-bottom:12px;}\n  #unete .club-row{display:grid;gap:8px;grid-template-columns:1fr;align-items:center;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid rgba(0,0,0,.08);}\n  #unete .club-row[hidden]{display:none;}\n  #unete .club-remove{background:none;border:0;font-size:1.8rem;line-height:1;cursor:pointer;color:inherit;justify-self:start;}\n  #unete .club-head{text-align:left;margin:20px 0 6px;}\n  #unete .club-check{display:flex;gap:10px;align-items:flex-start;text-align:left;margin-bottom:12px;font-size:1.3rem;}\n  #unete .club-check input{margin-top:3px;flex:none;}\n  #unete label.form-label{display:block;text-align:left;margin-bottom:4px;}\n  @media (min-width:700px){\n    #unete .club-grid{grid-template-columns:1fr 1fr;}\n    #unete .club-row{grid-template-columns:2fr 1.4fr 1fr 28px;}\n  }\n</style>\n<div id=\"unete\">\n  {%- form 'contact', id: 'ClubFamilyForm' -%}\n    {%- if form.posted_successfully? -%}\n      <p class=\"form-message alert alert--success blocks-radius\" tabindex=\"-1\" autofocus>¡Gracias! Hemos recibido tu solicitud. Te escribiremos en breve con tu carnet.</p>\n    {%- endif -%}\n    {%- if form.errors -%}\n      <p class=\"form-message alert alert--error blocks-radius\">{{ form.errors | default_errors }}</p>\n    {%- endif -%}\n    <input type=\"hidden\" name=\"contact[Origen]\" value=\"Landing Club Family\">\n\n    <div class=\"club-grid\">\n      <div class=\"form-field\">\n        <label class=\"form-label\" for=\"ClubEmail\">Tu email *</label>\n        <input id=\"ClubEmail\" type=\"email\" name=\"contact[email]\" class=\"form-control\" value=\"{{ form.email }}\" autocomplete=\"email\" autocorrect=\"off\" autocapitalize=\"off\" required>\n      </div>\n      <div class=\"form-field\">\n        <label class=\"form-label\" for=\"ClubPhone\">WhatsApp (opcional)</label>\n        <input id=\"ClubPhone\" type=\"tel\" name=\"contact[phone]\" class=\"form-control\" autocomplete=\"tel\">\n      </div>\n    </div>\n\n    <div class=\"club-head\">\n      <strong>Tu familia en el Club</strong>\n      <span style=\"font-size:1.2rem;opacity:.7;\"> (hasta 7 personas · solo nombre, parentesco y cumpleaños)</span>\n    </div>\n\n    <div class=\"club-row\" style=\"grid-template-columns:1fr;\">\n      <div class=\"club-row\" style=\"border:0;margin:0;padding:0;\">\n        <input type=\"text\" name=\"contact[Titular - Nombre]\" class=\"form-control\" placeholder=\"Tu nombre *\" aria-label=\"Tu nombre\" autocomplete=\"given-name\" required>\n        <input type=\"text\" class=\"form-control\" value=\"Titular\" aria-label=\"Parentesco\" disabled>\n        <input type=\"text\" name=\"contact[Titular - Cumpleanos]\" class=\"form-control\" placeholder=\"DD/MM\" inputmode=\"numeric\" pattern=\"(0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|1[0-2])\" title=\"Día/mes, por ejemplo 07/03\" aria-label=\"Tu cumpleaños (día/mes)\">\n        <span></span>\n      </div>\n    </div>\n\n      <div class=\"club-row\" data-club-row hidden>\n        <input type=\"text\" name=\"contact[Persona 2 - Nombre]\" class=\"form-control\" placeholder=\"Nombre\" aria-label=\"Nombre persona 2\" disabled>\n        <select name=\"contact[Persona 2 - Parentesco]\" class=\"form-control\" aria-label=\"Parentesco persona 2\" disabled>\n          <option value=\"\">Parentesco</option>\n          <option>Hijo/a</option><option>Nieto/a</option><option>Pareja</option><option>Abuelo/a</option><option>Tío/a</option><option>Otro</option>\n        </select>\n        <input type=\"text\" name=\"contact[Persona 2 - Cumpleanos]\" class=\"form-control\" placeholder=\"DD/MM\" inputmode=\"numeric\" pattern=\"(0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|1[0-2])\" title=\"Día/mes, por ejemplo 07/03\" aria-label=\"Cumpleaños persona 2 (día/mes)\" disabled>\n        <button type=\"button\" class=\"club-remove\" data-club-remove aria-label=\"Quitar persona 2\">×</button>\n      </div>\n      <div class=\"club-row\" data-club-row hidden>\n        <input type=\"text\" name=\"contact[Persona 3 - Nombre]\" class=\"form-control\" placeholder=\"Nombre\" aria-label=\"Nombre persona 3\" disabled>\n        <select name=\"contact[Persona 3 - Parentesco]\" class=\"form-control\" aria-label=\"Parentesco persona 3\" disabled>\n          <option value=\"\">Parentesco</option>\n          <option>Hijo/a</option><option>Nieto/a</option><option>Pareja</option><option>Abuelo/a</option><option>Tío/a</option><option>Otro</option>\n        </select>\n        <input type=\"text\" name=\"contact[Persona 3 - Cumpleanos]\" class=\"form-control\" placeholder=\"DD/MM\" inputmode=\"numeric\" pattern=\"(0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|1[0-2])\" title=\"Día/mes, por ejemplo 07/03\" aria-label=\"Cumpleaños persona 3 (día/mes)\" disabled>\n        <button type=\"button\" class=\"club-remove\" data-club-remove aria-label=\"Quitar persona 3\">×</button>\n      </div>\n      <div class=\"club-row\" data-club-row hidden>\n        <input type=\"text\" name=\"contact[Persona 4 - Nombre]\" class=\"form-control\" placeholder=\"Nombre\" aria-label=\"Nombre persona 4\" disabled>\n        <select name=\"contact[Persona 4 - Parentesco]\" class=\"form-control\" aria-label=\"Parentesco persona 4\" disabled>\n          <option value=\"\">Parentesco</option>\n          <option>Hijo/a</option><option>Nieto/a</option><option>Pareja</option><option>Abuelo/a</option><option>Tío/a</option><option>Otro</option>\n        </select>\n        <input type=\"text\" name=\"contact[Persona 4 - Cumpleanos]\" class=\"form-control\" placeholder=\"DD/MM\" inputmode=\"numeric\" pattern=\"(0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|1[0-2])\" title=\"Día/mes, por ejemplo 07/03\" aria-label=\"Cumpleaños persona 4 (día/mes)\" disabled>\n        <button type=\"button\" class=\"club-remove\" data-club-remove aria-label=\"Quitar persona 4\">×</button>\n      </div>\n      <div class=\"club-row\" data-club-row hidden>\n        <input type=\"text\" name=\"contact[Persona 5 - Nombre]\" class=\"form-control\" placeholder=\"Nombre\" aria-label=\"Nombre persona 5\" disabled>\n        <select name=\"contact[Persona 5 - Parentesco]\" class=\"form-control\" aria-label=\"Parentesco persona 5\" disabled>\n          <option value=\"\">Parentesco</option>\n          <option>Hijo/a</option><option>Nieto/a</option><option>Pareja</option><option>Abuelo/a</option><option>Tío/a</option><option>Otro</option>\n        </select>\n        <input type=\"text\" name=\"contact[Persona 5 - Cumpleanos]\" class=\"form-control\" placeholder=\"DD/MM\" inputmode=\"numeric\" pattern=\"(0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|1[0-2])\" title=\"Día/mes, por ejemplo 07/03\" aria-label=\"Cumpleaños persona 5 (día/mes)\" disabled>\n        <button type=\"button\" class=\"club-remove\" data-club-remove aria-label=\"Quitar persona 5\">×</button>\n      </div>\n      <div class=\"club-row\" data-club-row hidden>\n        <input type=\"text\" name=\"contact[Persona 6 - Nombre]\" class=\"form-control\" placeholder=\"Nombre\" aria-label=\"Nombre persona 6\" disabled>\n        <select name=\"contact[Persona 6 - Parentesco]\" class=\"form-control\" aria-label=\"Parentesco persona 6\" disabled>\n          <option value=\"\">Parentesco</option>\n          <option>Hijo/a</option><option>Nieto/a</option><option>Pareja</option><option>Abuelo/a</option><option>Tío/a</option><option>Otro</option>\n        </select>\n        <input type=\"text\" name=\"contact[Persona 6 - Cumpleanos]\" class=\"form-control\" placeholder=\"DD/MM\" inputmode=\"numeric\" pattern=\"(0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|1[0-2])\" title=\"Día/mes, por ejemplo 07/03\" aria-label=\"Cumpleaños persona 6 (día/mes)\" disabled>\n        <button type=\"button\" class=\"club-remove\" data-club-remove aria-label=\"Quitar persona 6\">×</button>\n      </div>\n      <div class=\"club-row\" data-club-row hidden>\n        <input type=\"text\" name=\"contact[Persona 7 - Nombre]\" class=\"form-control\" placeholder=\"Nombre\" aria-label=\"Nombre persona 7\" disabled>\n        <select name=\"contact[Persona 7 - Parentesco]\" class=\"form-control\" aria-label=\"Parentesco persona 7\" disabled>\n          <option value=\"\">Parentesco</option>\n          <option>Hijo/a</option><option>Nieto/a</option><option>Pareja</option><option>Abuelo/a</option><option>Tío/a</option><option>Otro</option>\n        </select>\n        <input type=\"text\" name=\"contact[Persona 7 - Cumpleanos]\" class=\"form-control\" placeholder=\"DD/MM\" inputmode=\"numeric\" pattern=\"(0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|1[0-2])\" title=\"Día/mes, por ejemplo 07/03\" aria-label=\"Cumpleaños persona 7 (día/mes)\" disabled>\n        <button type=\"button\" class=\"club-remove\" data-club-remove aria-label=\"Quitar persona 7\">×</button>\n      </div>\n\n    <div style=\"margin:4px 0 16px;text-align:left;\">\n      <button type=\"button\" class=\"btn btn--secondary w-full\" data-club-add>+ Añadir a alguien de tu familia (<span data-club-count>4</span> de 7)</button>\n    </div>\n\n    <div class=\"form-field\" style=\"margin-bottom:16px;\">\n      <label class=\"form-label\" for=\"ClubAddress\">Dirección del titular (opcional)</label>\n      <input id=\"ClubAddress\" type=\"text\" name=\"contact[Direccion]\" class=\"form-control\" autocomplete=\"street-address\">\n    </div>\n\n    <label class=\"club-check\">\n      <input type=\"checkbox\" name=\"contact[Acepta privacidad]\" value=\"Si\" required>\n      <span>Acepto la <a href=\"{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}\" target=\"_blank\" rel=\"noopener\">política de privacidad</a> y confirmo que puedo dar estos datos de mi familia. *</span>\n    </label>\n    <label class=\"club-check\">\n      <input type=\"checkbox\" name=\"contact[Acepta comunicaciones]\" value=\"Si\">\n      <span>Quiero recibir novedades, promociones y consejos del Club por email y/o WhatsApp.</span>\n    </label>\n\n    <button type=\"submit\" class=\"btn btn--primary w-full\" name=\"commit\">QUIERO SER DEL CLUB →</button>\n    <p style=\"font-size:1.2rem;opacity:.7;margin-top:10px;\">Descuentos del Club en todas las compras, excepto Outlet.</p>\n  {%- endform -%}\n</div>\n<script>\n  (function () {\n    var form = document.getElementById('ClubFamilyForm');\n    if (!form) return;\n    var rows = Array.prototype.slice.call(form.querySelectorAll('[data-club-row]'));\n    var addBtn = form.querySelector('[data-club-add]');\n    var counter = form.querySelector('[data-club-count]');\n    function setRow(row, show) {\n      row.hidden = !show;\n      Array.prototype.forEach.call(row.querySelectorAll('input,select'), function (el) { el.disabled = !show; if (!show) el.value = ''; });\n    }\n    function refresh() {\n      var shown = rows.filter(function (r) { return !r.hidden; }).length;\n      counter.textContent = shown + 1;\n      addBtn.hidden = shown >= rows.length;\n    }\n    rows.forEach(function (r, i) { setRow(r, i < 3); });\n    refresh();\n    addBtn.addEventListener('click', function () {\n      var next = rows.filter(function (r) { return r.hidden; })[0];\n      if (next) { setRow(next, true); refresh(); var f = next.querySelector('input'); if (f) f.focus(); }\n    });\n    rows.forEach(function (r) {\n      r.querySelector('[data-club-remove]').addEventListener('click', function () { setRow(r, false); refresh(); });\n    });\n  })();\n</script>",
