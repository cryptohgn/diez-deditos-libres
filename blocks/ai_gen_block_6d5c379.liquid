{% assign extra_info_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .features-section-{{ extra_info_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.section_bg_color }};
  }

  .features-container-{{ extra_info_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-header-{{ extra_info_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .features-title-{{ extra_info_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
  }

  .features-subtitle-{{ extra_info_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .features-grid-{{ extra_info_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    /* margin-bottom: 40px; */ /* Eliminado, ya no hay botón central debajo */
  }

  .features-item-{{ extra_info_id }} {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between; /* Para asegurar que el botón siempre esté abajo */
  }

  .features-item-content-wrapper-{{ extra_info_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1; /* Para que el contenido ocupe el espacio disponible */
    margin-bottom: 20px; /* Espacio entre el texto y el botón */
  }

  .features-icon-wrapper-{{ extra_info_id }} {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .features-icon-{{ extra_info_id }} {
    width: 60px;
    height: 60px;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 1.5;
  }

  .features-custom-icon-{{ extra_info_id }} {
    width: 85px;
    height: 85px;
    object-fit: contain;
  }

  .features-item-title-{{ extra_info_id }} {
    font-size: {{ block.settings.feature_title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px 0;
  }

  .features-item-text-{{ extra_info_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  /* Clases para los botones individuales (reutilizando estilos del botón central) */
  .features-item-button-{{ extra_info_id }} {
    display: inline-block;
    padding: 15px 30px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    text-align: center;
    min-height: {{ settings.buttons_height }}px;
    margin-top: auto; /* Empuja el botón hacia abajo si el contenido es variable */
    
    {% if settings.buttons_corner_radius == 'square' %}
      border-radius: 0;
    {% elsif settings.buttons_corner_radius == 'slightly' %}
      border-radius: 4px;
    {% elsif settings.buttons_corner_radius == 'soft-pill' %}
      border-radius: 12px;
    {% elsif settings.buttons_corner_radius == 'round' %}
      border-radius: 50px;
    {% endif %}
    
    {% if settings.buttons_font == 'heading' %}
      font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    {% else %}
      font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    {% endif %}
    
    font-weight: {{ settings.buttons_font_weight }};
    letter-spacing: {{ settings.buttons_letter_spacing }}%;
    text-transform: {{ settings.buttons_transform }};
    
    {% if block.settings.button_style == 'primary' %}
      background-color: rgb(var(--color-button));
      color: rgb(var(--color-button-text));
      border: 1px solid rgb(var(--color-button));
    {% else %}
      background-color: rgb(var(--color-base-background-1));
      color: rgb(var(--color-base-text));
      border: 1px solid rgb(var(--color-base-outline-button-labels));
    {% endif %}
  }

  .features-item-button-{{ extra_info_id }}:hover {
    {% if block.settings.button_style == 'primary' %}
      background-color: rgb(var(--color-button-text));
      color: rgb(var(--color-button));
    {% else %}
      background-color: rgb(var(--color-base-text));
      color: rgb(var(--color-base-background-1));
    {% endif %}
  }


  @media screen and (max-width: 767px) {
    .features-grid-{{ extra_info_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
{% endstyle %}

<div class="features-section-{{ extra_info_id }}" {{ block.shopify_attributes }}>
  <div class="features-container-{{ extra_info_id }}">
    <div class="features-header-{{ extra_info_id }}">
      {% if block.settings.main_title != blank %}
        <h2 class="features-title-{{ extra_info_id }}">{{ block.settings.main_title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="features-subtitle-{{ extra_info_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="features-grid-{{ extra_info_id }}">
      <div class="features-item-{{ extra_info_id }}">
        <div class="features-item-content-wrapper-{{ extra_info_id }}">
          <div class="features-icon-wrapper-{{ extra_info_id }}">
            {% if block.settings.icon_1 %}
              <img src="{{ block.settings.icon_1 | image_url: width: 120 }}" alt="{{ block.settings.feature_1_title }}" class="features-custom-icon-{{ extra_info_id }}">
            {% else %}
              <svg class="features-icon-{{ extra_info_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 18h20l-2-6H4l-2 6z"/>
                <path d="M6 12V9a6 6 0 0 1 12 0v3"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
            {% endif %}
          </div>
          {% if block.settings.feature_1_title != blank %}
            <h3 class="features-item-title-{{ extra_info_id }}">{{ block.settings.feature_1_title }}</h3>
          {% endif %}
          {% if block.settings.feature_1_text != blank %}
            <p class="features-item-text-{{ extra_info_id }}">{{ block.settings.feature_1_text }}</p>
          {% endif %}
        </div>
        {% if block.settings.feature_1_button_text != blank %}
          <a href="{{ block.settings.feature_1_button_link }}" class="features-item-button-{{ extra_info_id }}">
            {{ block.settings.feature_1_button_text }}
          </a>
        {% endif %}
      </div>

      <div class="features-item-{{ extra_info_id }}">
        <div class="features-item-content-wrapper-{{ extra_info_id }}">
          <div class="features-icon-wrapper-{{ extra_info_id }}">
            {% if block.settings.icon_2 %}
              <img src="{{ block.settings.icon_2 | image_url: width: 120 }}" alt="{{ block.settings.feature_2_title }}" class="features-custom-icon-{{ extra_info_id }}">
            {% else %}
              <svg class="features-icon-{{ extra_info_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                <path d="M9 2v5"/>
                <path d="M15 2v5"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            {% endif %}
          </div>
          {% if block.settings.feature_2_title != blank %}
            <h3 class="features-item-title-{{ extra_info_id }}">{{ block.settings.feature_2_title }}</h3>
          {% endif %}
          {% if block.settings.feature_2_text != blank %}
            <p class="features-item-text-{{ extra_info_id }}">{{ block.settings.feature_2_text }}</p>
          {% endif %}
        </div>
        {% if block.settings.feature_2_button_text != blank %}
          <a href="{{ block.settings.feature_2_button_link }}" class="features-item-button-{{ extra_info_id }}">
            {{ block.settings.feature_2_button_text }}
          </a>
        {% endif %}
      </div>

      <div class="features-item-{{ extra_info_id }}">
        <div class="features-item-content-wrapper-{{ extra_info_id }}">
          <div class="features-icon-wrapper-{{ extra_info_id }}">
            {% if block.settings.icon_3 %}
              <img src="{{ block.settings.icon_3 | image_url: width: 120 }}" alt="{{ block.settings.feature_3_title }}" class="features-custom-icon-{{ extra_info_id }}">
            {% else %}
              <svg class="features-icon-{{ extra_info_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                <path d="M2 17l10 5 10-5"/>
                <path d="M2 12l10 5 10-5"/>
              </svg>
            {% endif %}
          </div>
          {% if block.settings.feature_3_title != blank %}
            <h3 class="features-item-title-{{ extra_info_id }}">{{ block.settings.feature_3_title }}</h3>
          {% endif %}
          {% if block.settings.feature_3_text != blank %}
            <p class="features-item-text-{{ extra_info_id }}">{{ block.settings.feature_3_text }}</p>
          {% endif %}
        </div>
        {% if block.settings.feature_3_button_text != blank %}
          <a href="{{ block.settings.feature_3_button_link }}" class="features-item-button-{{ extra_info_id }}">
            {{ block.settings.feature_3_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    {# {% if block.settings.button_text != blank %}
      <div class="features-cta-{{ extra_info_id }}">
        <a href="{{ block.settings.button_link }}" class="features-button-{{ extra_info_id }}">
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %} #}
  </div>
</div>

{% schema %}
{
  "name": "Features grid",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main title",
      "default": "Our Features"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover what makes us special"
    },
    {
      "type": "header",
      "content": "Feature 1"
    },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "Custom icon"
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Title",
      "default": "Flexible Design"
    },
    {
      "type": "textarea",
      "id": "feature_1_text",
      "label": "Description",
      "default": "Adaptable and comfortable for all day wear"
    },
    {
      "type": "text", /* Nuevo: Texto para el botón de la Feature 1 */
      "id": "feature_1_button_text",
      "label": "Button text",
      "default": "Learn more"
    },
    {
      "type": "url", /* Nuevo: Enlace para el botón de la Feature 1 */
      "id": "feature_1_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "Custom icon"
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Title",
      "default": "Flat Sole"
    },
    {
      "type": "textarea",
      "id": "feature_2_text",
      "label": "Description",
      "default": "Perfect balance and stability for natural movement"
    },
    {
      "type": "text", /* Nuevo: Texto para el botón de la Feature 2 */
      "id": "feature_2_button_text",
      "label": "Button text",
      "default": "Learn more"
    },
    {
      "type": "url", /* Nuevo: Enlace para el botón de la Feature 2 */
      "id": "feature_2_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "image_picker",
      "id": "icon_3",
      "label": "Custom icon"
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Title",
      "default": "Wide Fit"
    },
    {
      "type": "textarea",
      "id": "feature_3_text",
      "label": "Description",
      "default": "Spacious design that accommodates natural foot shape"
    },
    {
      "type": "text", /* Nuevo: Texto para el botón de la Feature 3 */
      "id": "feature_3_button_text",
      "label": "Button text",
      "default": "Learn more"
    },
    {
      "type": "url", /* Nuevo: Enlace para el botón de la Feature 3 */
      "id": "feature_3_button_link",
      "label": "Button link"
    },
    
    /* ELIMINADO: Sección de botón central */
    /*
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    */
    { /* Este setting button_style sigue siendo útil para los botones individuales */
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "primary"
